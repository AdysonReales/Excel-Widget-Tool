{
  "name": "little-grid",
  "version": "1.0.0",
  "private": true,
  "description": "A little spreadsheet widget and new-tab companion",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "build:extension": "node scripts/build-extension.js",
    "test": "node tests/csv.test.js && node tests/formula.test.js",
    "test:resize": "node tests/resize-browser.cjs",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.adysonreales.littlegrid",
    "productName": "Little Grid",
    "files": [
      "desktop/**/*",
      "shared/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
