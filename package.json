{
  "name": "little-grid",
  "version": "1.0.0",
  "private": true,
  "description": "A little spreadsheet widget and new-tab companion",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "build:extension": "node scripts/build-extension.js",
    "test": "node tests/csv.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12"
  },
  "build": { "appId": "com.adysonreales.littlegrid", "productName": "Little Grid", "files": ["desktop/**/*", "shared/**/*"], "asarUnpack": ["desktop/desktop-layer.ps1"], "win": { "target": "nsis" }, "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true } }
}
